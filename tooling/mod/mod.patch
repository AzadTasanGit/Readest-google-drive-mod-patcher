+import { describe, expect, it } from 'vitest';
+import type { SystemSettings } from '@/types/settings';
+import { requiresSignInToSyncLibrary } from '@/app/library/utils/libraryUtils';
+
+const NO_CLOUD = {} as SystemSettings;
+const GOOGLE_DRIVE_CONNECTED = { googleDrive: { enabled: true } } as SystemSettings;
+
+describe('requiresSignInToSyncLibrary', () => {
+  it('never diverts a signed-in user to the login screen', () => {
+    expect(requiresSignInToSyncLibrary(NO_CLOUD, true)).toBe(false);
+  });
+
+  it('sends a signed-out user with no cloud of their own to sign in', () => {
+    expect(requiresSignInToSyncLibrary(NO_CLOUD, false)).toBe(true);
+  });
+
+  // Also guards the paywall flip: with the premium gate on, a free user's Drive
+  // backend is paused and this would demand a sign-in instead of syncing.
+  it('lets a signed-out free user sync through their own Google Drive', () => {
+    expect(requiresSignInToSyncLibrary(GOOGLE_DRIVE_CONNECTED, false)).toBe(false);
+  });
+});
diff --git a/apps/readest-app/src/__tests__/app/library/recent-shelf-hide.test.tsx b/apps/readest-app/src/__tests__/app/library/recent-shelf-hide.test.tsx
new file mode 100644
index 000000000..8e8d603a8
--- /dev/null
+++ b/apps/readest-app/src/__tests__/app/library/recent-shelf-hide.test.tsx
@@ -0,0 +1,117 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { cleanup, fireEvent, render, screen } from '@testing-library/react';
+
+vi.mock('@/hooks/useTranslation', () => ({
+  useTranslation: () => (key: string) => key,
+}));
+
+// The keydown hook pulls in EnvContext + device store, which these tests don't
+// exercise; stub it to a no-op ref.
+vi.mock('@/hooks/useKeyDownActions', () => ({
+  useKeyDownActions: () => ({ current: null }),
+}));
+
+import SelectModeActions from '@/app/library/components/SelectModeActions';
+import { canHideFromRecentShelf, selectRecentShelfBooks } from '@/app/library/utils/libraryUtils';
+import { Book } from '@/types/book';
+
+afterEach(cleanup);
+
+const SHELF_SIZE = 10;
+const HIDDEN_AT = 5_000;
+
+/** A book that is being read (has progress), last updated at `updatedAt`. */
+const readingBook = (hash: string, updatedAt: number): Book =>
+  ({
+    hash,
+    format: 'EPUB',
+    title: hash,
+    author: '',
+    createdAt: 0,
+    updatedAt,
+    progress: [1, 100],
+  }) as Book;
+
+const hashesOf = (books: Book[]) => books.map((book) => book.hash);
+
+describe('selectRecentShelfBooks with hidden books', () => {
+  it('leaves a hidden book off the shelf until it is read again', () => {
+    const hidden = readingBook('hidden', HIDDEN_AT - 1);
+    const visible = readingBook('visible', HIDDEN_AT - 2);
+
+    const shelf = selectRecentShelfBooks([hidden, visible], SHELF_SIZE, { hidden: HIDDEN_AT });
+
+    expect(hashesOf(shelf)).toEqual(['visible']);
+  });
+
+  it('brings a hidden book back once its updatedAt moves past the hide time', () => {
+    const readAgain = readingBook('read-again', HIDDEN_AT + 1);
+
+    const shelf = selectRecentShelfBooks([readAgain], SHELF_SIZE, { 'read-again': HIDDEN_AT });
+
+    expect(hashesOf(shelf)).toEqual(['read-again']);
+  });
+});
+
+describe('canHideFromRecentShelf', () => {
+  const shelf = [readingBook('a', 1), readingBook('b', 2)];
+
+  it('is false when nothing is selected', () => {
+    expect(canHideFromRecentShelf([], shelf)).toBe(false);
+  });
+
+  it('is true when every selected book is on the shelf', () => {
+    expect(canHideFromRecentShelf(['a', 'b'], shelf)).toBe(true);
+  });
+
+  it('is false when any selected item is not on the shelf, so a hide never skips part of it', () => {
+    expect(canHideFromRecentShelf(['a', 'grid-only'], shelf)).toBe(false);
+  });
+});
+
+describe('SelectModeActions "Hide" action', () => {
+  const noop = () => {};
+  const baseProps = {
+    selectedBooks: ['0123456789abcdef0123456789abcdef'],
+    safeAreaBottom: 0,
+    onOpen: noop,
+    onGroup: noop,
+    onDetails: noop,
+    onStatus: noop,
+    onDownload: noop,
+    onSend: noop,
+    onDelete: noop,
+    onCancel: noop,
+  };
+
+  const hideButton = () => screen.getByText('Hide').closest('button') as HTMLButtonElement;
+
+  it('is absent unless the recently-read shelf is showing', () => {
+    render(<SelectModeActions {...baseProps} />);
+
+    expect(screen.queryByText('Hide')).toBeNull();
+  });
+
+  it('is disabled when the selection cannot be hidden from the shelf', () => {
+    render(<SelectModeActions {...baseProps} hideFromRecentEnabled canHideFromRecent={false} />);
+
+    expect(hideButton().className).toContain('btn-disabled');
+  });
+
+  it('hides the selection when enabled and clicked', () => {
+    const onHideFromRecent = vi.fn();
+    render(
+      <SelectModeActions
+        {...baseProps}
+        hideFromRecentEnabled
+        canHideFromRecent
+        onHideFromRecent={onHideFromRecent}
+      />,
+    );
+
+    expect(hideButton().className).not.toContain('btn-disabled');
+    fireEvent.click(hideButton());
+
+    expect(onHideFromRecent).toHaveBeenCalledOnce();
+  });
+});
